# === Virtual Environment ===
# Создать: python -m venv .venv
# Активировать: .venv\Scripts\activate
# Деактивировать: deactivate
.venv/
venv/
ENV/

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
*.whl

# === PyInstaller ===
build/
dist/
*.spec.bak
manifest

# === pytest ===
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# === Локальные бэкапы (могут содержать чувствительные данные реестра) ===
backups/

# === Состояние прогонов верификации (verify/state) ===
# Снимки профиля, снятые скриптом FIX12_verify_hole.ps1. Содержат
# пользовательские настройки и НЕ должны попадать в историю.
verify/state/

# === Аварийные снимки состояния реестра (SAFETY_NET_*) ===
# Экспорты веток живой системы: содержат пользовательские настройки и могут
# занимать сотни мегабайт (SAFETY_NET_20260926_144444/pre_state.reg — 100 МБ).
# В репозитории им не место; хранить только локально, вне рабочей копии.
SAFETY_NET_*/

# === Логи ===
# Не *.log, а *.log*: ротация переименовывает файл в layout_cleaner.log.1,
# и такой он в .gitignore не попадал — 10 МБ логов в истории.
*.log
*.log.*

# === Собранные портативные архивы ===
*.zip
*.tar.gz
*.tar.bz2

# === IDE ===
.vscode/
.idea/
*.swp
*.swo
*~

# === pip-compile (locked requirements можно и нужно коммитить) ===
# .in-файлы (источники) — коммитим, .txt (результат) — тоже

# === OS ===
Thumbs.db
desktop.ini

# === Локальные настройки (если появятся) ===
*.local
